# Gemini API Key (System 2 Organizer LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama System 1 Endpoint & Model
OLLAMA_SYSTEMONE_URL=http://localhost:11434/v1/systemone
NIMBLE_MODEL=nimble

# Minimum confidence score (0.0 - 1.0) before auto-assigning a color without prompting
CONFIDENCE_THRESHOLD=0.75

# Google Calendar Settings
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
